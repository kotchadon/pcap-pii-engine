{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pcap-pii-engine/schemas/report-v1.schema.json",
  "title": "PCAP PII Engine report v1.1 with network evidence",
  "type": "object",
  "required": [
    "metadata",
    "summary",
    "flows",
    "findings",
    "limitations",
    "packet_evidence",
    "stream_evidence",
    "http_evidence",
    "field_evidence",
    "capture_evidence"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "engine",
        "version",
        "report_schema_version",
        "detection_method",
        "confidence_type",
        "threshold",
        "raw_values_included",
        "scope",
        "evidence_schema_version"
      ],
      "properties": {
        "engine": {
          "const": "pcap-pii-engine"
        },
        "version": {
          "type": "string"
        },
        "report_schema_version": {
          "const": "1.1.0"
        },
        "detection_method": {
          "type": "string"
        },
        "confidence_type": {
          "type": "string"
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "raw_values_included": {
          "type": "boolean"
        },
        "scope": {
          "type": "string"
        },
        "analysis_limits": {
          "type": "object",
          "properties": {
            "max_capture_bytes": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "max_packets": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "max_flows": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "max_tcp_payload_bytes": {
              "$ref": "#/$defs/nonnegativeInteger"
            }
          },
          "additionalProperties": false
        },
        "evidence_schema_version": {
          "const": "1.0.0"
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "packets_captured",
        "non_tcp_or_unsupported_packets",
        "flows_processed",
        "http_flows",
        "http_messages",
        "http_transactions",
        "unpaired_requests",
        "unpaired_responses",
        "total_data_bytes",
        "processing_time_seconds",
        "potential_leaks",
        "stream_gaps"
      ],
      "properties": {
        "packets_captured": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "non_tcp_or_unsupported_packets": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "flows_processed": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "http_flows": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "http_messages": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "http_transactions": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unpaired_requests": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unpaired_responses": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "total_data_bytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "processing_time_seconds": {
          "type": "number",
          "minimum": 0
        },
        "potential_leaks": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "stream_gaps": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "capture_truncated_records": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "capture_malformed_records": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "analysis_incomplete": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capture_evidence": {
      "type": "object",
      "required": [
        "capture_sha256",
        "capture_bytes",
        "identity_status",
        "frame_index_origin",
        "range_convention"
      ],
      "properties": {
        "capture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "identity_status": {
          "const": "verified_read"
        },
        "frame_index_origin": {
          "const": 1
        },
        "range_convention": {
          "const": "zero_based_half_open"
        }
      },
      "additionalProperties": true
    },
    "packet_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packetEvidence"
      }
    },
    "stream_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/streamEvidence"
      }
    },
    "http_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/httpEvidence"
      }
    },
    "field_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldEvidence"
      }
    }
  },
  "$defs": {
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "endpoint": {
      "type": "object",
      "required": [
        "ip",
        "port"
      ],
      "properties": {
        "ip": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "additionalProperties": true
    },
    "flow": {
      "type": "object",
      "required": [
        "flow_id",
        "endpoints",
        "packets",
        "http_messages",
        "http_transactions",
        "unpaired_requests",
        "unpaired_responses",
        "stream_gaps"
      ],
      "properties": {
        "flow_id": {
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "packets": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "http_messages": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "http_transactions": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unpaired_requests": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unpaired_responses": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "stream_gaps": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "pii_type",
        "location",
        "confidence",
        "value",
        "detector",
        "flow_id",
        "http_message_id",
        "http_request_id",
        "http_message_type",
        "timestamp",
        "source_ip",
        "source_port",
        "destination_ip",
        "destination_port",
        "http_start_line",
        "evidence"
      ],
      "properties": {
        "pii_type": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "value": {
          "type": "string"
        },
        "detector": {
          "type": "string"
        },
        "flow_id": {
          "type": "string"
        },
        "http_message_id": {
          "type": "string"
        },
        "http_request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "http_message_type": {
          "enum": [
            "request",
            "response"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "source_ip": {
          "type": "string"
        },
        "source_port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "destination_ip": {
          "type": "string"
        },
        "destination_port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "http_start_line": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/findingEvidence"
        }
      },
      "additionalProperties": true
    },
    "evidenceRange": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "findingEvidence": {
      "type": "object",
      "required": [
        "http_message_id",
        "scope",
        "field_ids",
        "raw_detection_span",
        "limitations"
      ],
      "properties": {
        "http_message_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "field",
            "candidate_fields",
            "message"
          ]
        },
        "field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 64
        },
        "raw_detection_span": {
          "const": "unavailable"
        },
        "decoded_text_span": {
          "$ref": "#/$defs/evidenceRange"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "packetEvidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "frame_index",
        "disposition",
        "record_offset",
        "data_offset",
        "captured_length",
        "wire_length"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_index": {
          "type": "integer",
          "minimum": 1
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        },
        "record_offset": {
          "type": "integer",
          "minimum": 0
        },
        "data_offset": {
          "type": "integer",
          "minimum": 0
        },
        "captured_length": {
          "type": "integer",
          "minimum": 0
        },
        "wire_length": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "number"
        },
        "timestamp_resolution": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "section_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "interface_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "streamEvidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "stream_id",
        "flow_id",
        "row_type"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "row_type": {
          "enum": [
            "stream",
            "source_range"
          ]
        },
        "stream_start": {
          "type": "integer",
          "minimum": 0
        },
        "stream_end": {
          "type": "integer",
          "minimum": 0
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_start": {
          "type": "integer",
          "minimum": 0
        },
        "frame_end": {
          "type": "integer",
          "minimum": 0
        },
        "file_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "file_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "safe_prefix_length": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "granularity": {
          "const": "exact_raw_range"
        }
      },
      "additionalProperties": true
    },
    "httpEvidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "http_message_id",
        "flow_id",
        "stream_id",
        "protocol",
        "pairing_status",
        "stream_start",
        "stream_end",
        "field_count",
        "contiguous"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "http_message_id": {
          "type": "string",
          "minLength": 1
        },
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "enum": [
            "http/1",
            "h2"
          ]
        },
        "pairing_status": {
          "type": "string",
          "minLength": 1
        },
        "stream_start": {
          "type": "integer",
          "minimum": 0
        },
        "stream_end": {
          "type": "integer",
          "minimum": 0
        },
        "field_count": {
          "type": "integer",
          "minimum": 0
        },
        "contiguous": {
          "type": "boolean"
        },
        "stream_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRange"
          }
        }
      },
      "additionalProperties": true
    },
    "fieldEvidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "field_id",
        "field_index",
        "http_message_id",
        "stream_id",
        "location",
        "source_category",
        "stream_ranges",
        "decoded_text_span",
        "transformations",
        "granularity",
        "limitations"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "field_id": {
          "type": "string",
          "minLength": 1
        },
        "http_message_id": {
          "type": "string",
          "minLength": 1
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "field_index": {
          "type": "integer",
          "minimum": 0
        },
        "location": {
          "type": "string"
        },
        "source_category": {
          "type": "string",
          "minLength": 1
        },
        "stream_ranges": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/evidenceRange"
          }
        },
        "decoded_text_span": {
          "$ref": "#/$defs/evidenceRange"
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "granularity": {
          "enum": [
            "exact_raw_range",
            "exact_stream_range",
            "transformed_source_range",
            "message_level_only",
            "unavailable"
          ]
        },
        "text_encoding": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
