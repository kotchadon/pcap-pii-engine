{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pcap-pii-engine/schemas/ground-truth-v1.schema.json",
  "title": "TRACE ground-truth manifest v1",
  "description": "Independent annotations of PERSON_NAME and USERNAME spans for the decoded HTTP fields of ONE capture. Reference labels must not be derived from any detector's output. packet_pii.groundtruth.parse_manifest enforces this schema plus cross-field rules (unique field ids and addresses, non-overlapping spans, span bounds).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "capture", "labels", "annotation_scope", "fields"],
  "properties": {
    "schema_version": {"const": "trace-ground-truth/1"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "created", "synthetic", "provenance"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["controlled_synthetic_fixture", "hand_designed_demonstration", "human_annotated_capture"]},
        "description": {"type": "string", "maxLength": 2000},
        "created": {"type": "string", "minLength": 10, "maxLength": 40, "description": "ISO-8601 date or date-time"},
        "synthetic": {"type": "boolean"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label_source", "labels_derived_from_model_output"],
          "properties": {
            "label_source": {"enum": ["constructed_by_generator", "human_annotation"]},
            "labels_derived_from_model_output": {"const": false, "description": "Attestation: model output is never reference truth."},
            "generator": {"type": "string", "minLength": 1, "maxLength": 200},
            "annotators": {"type": "integer", "minimum": 1, "description": "Required when label_source is human_annotation."},
            "notes": {"type": "string", "maxLength": 2000}
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the exact capture file the annotations describe."},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "labels": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["PERSON_NAME", "USERNAME"]}
    },
    "annotation_scope": {
      "enum": ["listed_fields_only", "all_fields_in_listed_messages"],
      "description": "With all_fields_in_listed_messages every extracted field of each listed message must be listed (negatives have an empty spans array); unlisted fields make the evaluation partial."
    },
    "fields": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_id", "flow", "message", "location", "text_sha256", "text_length", "spans"],
        "properties": {
          "field_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$", "description": "Unique, non-sensitive identifier used in error reports."},
          "flow": {
            "type": "object", "additionalProperties": false, "required": ["client", "server"],
            "properties": {
              "client": {"type": "string", "description": "ip:port of the connection initiator"},
              "server": {"type": "string", "description": "ip:port of the responder"},
              "session": {"type": "integer", "minimum": 1, "default": 1, "description": "nth TCP session of this endpoint pair (tuple reuse)"}
            }
          },
          "message": {
            "type": "object", "additionalProperties": false, "required": ["type", "ordinal"],
            "properties": {
              "type": {"enum": ["request", "response"]},
              "ordinal": {"type": "integer", "minimum": 1, "description": "1-based position among same-direction messages of the session"}
            }
          },
          "location": {"type": "string", "minLength": 1, "maxLength": 1024, "description": "Field location as extracted, e.g. json_body.profile.displayName, header.x-customer-name, query_parameter.user, form.username"},
          "occurrence": {"type": "integer", "minimum": 0, "default": 0, "description": "0-based index among fields of this message with the same location"},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the decoded UTF-8 field text; binds the annotation to the evidence."},
          "text_length": {"type": "integer", "minimum": 1, "description": "Length in Unicode code points"},
          "category": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$", "description": "Free-form stratum, e.g. positive:request or hard_negative:company_name"},
          "spans": {
            "type": "array", "maxItems": 1000,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["start", "end", "label"],
              "properties": {
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 1, "description": "exclusive; code points; end <= text_length"},
                "label": {"enum": ["PERSON_NAME", "USERNAME"]}
              }
            }
          }
        }
      }
    }
  }
}
